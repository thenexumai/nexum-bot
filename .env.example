# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token

# ── Optional: Admin IDs (comma-separated Telegram user IDs) ──────────────────
ADMIN_IDS=123456789,987654321

# ── Optional: Public mode (anyone can use bot) ─────────────────────────────
PUBLIC_BOT=true

# ── Web App URL (Railway service URL) ─────────────────────────────────────────
WEBAPP_URL=https://your-app.railway.app

# ── Port ──────────────────────────────────────────────────────────────────────
PORT=3000

# ── Database path ─────────────────────────────────────────────────────────────
DB_PATH=./data/nexum.db

# ── AI Provider Keys (round-robin: add up to 10 per provider) ────────────────
# Cerebras (fastest free llama)
CB1=
CB2=

# Groq (fast llama, also used for STT)
GR1=
GR2=

# Gemini (vision support)
G1=
G2=

# Grok (xAI)
GK1=

# SambaNova
SN1=

# Together AI
TO1=

# OpenRouter (many models)
OR1=

# DeepSeek
DS1=

# Claude / Anthropic
CL1=

# ── Web Search (Serper) ───────────────────────────────────────────────────────
SERPER_KEY=
SERPER_KEY2=
SERPER_KEY3=
