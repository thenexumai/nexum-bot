# ════════════════════════════════════════════════════════════════════════
# NEXUM — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── ADMIN ─────────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789

# ── PUBLIC MODE ───────────────────────────────────────────────────────────────
# Set to "true" to allow any Telegram user to use the bot (not just admins)
PUBLIC_BOT=true

# ── WEB APP URL ───────────────────────────────────────────────────────────────
# Your Railway service URL (used for Telegram Web Apps / mini-apps button)
WEBAPP_URL=https://your-app.railway.app

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3000

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Path to SQLite database file. On Railway, use a persistent volume path.
DB_PATH=./data/nexum.db

# ════════════════════════════════════════════════════════════════════════
# AI PROVIDER KEYS
# Add up to 10 keys per provider for round-robin rotation.
# The bot uses these as SYSTEM keys (free for all users on Free/Middle plans).
# Pro users can bring their own keys via /setkey (BYOK).
# ════════════════════════════════════════════════════════════════════════

# Cerebras — fastest (Llama 3.3 70B)
CB1=
CB2=

# Groq — fast (Llama 3.3 70B, also used for speech-to-text)
GR1=
GR2=

# Gemini — vision support (Gemini 1.5 Flash)
G1=
G2=

# Grok — xAI
GK1=

# SambaNova
SN1=

# Together AI
TO1=

# OpenRouter — access to many models
OR1=

# DeepSeek
DS1=

# Claude / Anthropic
CL1=

# ── WEB SEARCH ────────────────────────────────────────────────────────────────
# Serper API keys for web search (https://serper.dev)
SERPER_KEY=
SERPER_KEY2=
SERPER_KEY3=
