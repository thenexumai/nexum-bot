# ===========================================
# NEXUM v1.0 — Environment Configuration
# Copy this file to .env and fill in values
# ===========================================

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_UID=387182659

# --- Server ---
PORT=3000
DATABASE_PATH=./data/nexum.db
LOG_DIR=./logs
NODE_ENV=production

# --- Railway Deployment (optional, for WS URL in /link_pc) ---
# RAILWAY_STATIC_URL=your-app.railway.app

# --- AI Providers (add keys for each provider you want to use) ---
# Round-robin: add up to KEY_10 for load balancing

# Claude (Anthropic)
CLAUDE_KEY_1=
CLAUDE_KEY_2=

# Gemini (Google)
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# Groq
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=

# Cerebras
CEREBRAS_KEY_1=
CEREBRAS_KEY_2=

# Grok (xAI)
GROK_KEY_1=
GROK_KEY_2=

# SambaNova
SAMBANOVA_KEY_1=
SAMBANOVA_KEY_2=

# Together AI
TOGETHER_KEY_1=
TOGETHER_KEY_2=

# OpenRouter
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=

# DeepSeek
DEEPSEEK_KEY_1=
DEEPSEEK_KEY_2=

# --- Search ---
SERPER_KEY=
